<%- include('partials/header') %>
<section class="page-header">
  <div>
    <span class="eyebrow">Give support</span>
    <h1>Keep a learner<br />in the room.</h1>
  </div>
  <p>
    Your support helps provide learning materials, meals, safe spaces and the
    everyday essentials that keep children learning.
  </p>
</section>
<section class="section">
  <div class="donate-grid">
    <div class="prose">
      <span class="kicker">Scholarships and essentials</span>
      <h2>Education is a community effort.</h2>
      <p>
        For a refugee family, the cost of school supplies or transport can be
        the difference between attending and staying home. Your contribution
        helps us remove those barriers and make sure learners have what they
        need to participate fully.
      </p>
      <p>
        Choose a giving level that works for you, or get in touch to discuss
        sponsoring a specific classroom, club or learner support programme.
      </p>
      <a class="button" href="mailto:hello@kaloboyei.org">Talk to our team ↗</a>
    </div>
    <div class="donation-box">
      <h2>Ways to give</h2>
      <div class="donation-option">
        <span>M-Pesa Paybill</span><code>404040</code
        ><button class="copy" data-copy="404040">Copy</button>
      </div>
      <div class="donation-option">
        <span>Account name</span><code>KALOBOYEI</code
        ><button class="copy" data-copy="KALOBOYEI">Copy</button>
      </div>
      <div class="donation-option">
        <span>Bank transfer</span><code>Coming soon</code>
      </div>
      <p style="color: #bfd1ca; font-size: 12px; margin-top: 25px">
        Please include “school support” as your reference. We will send a
        receipt and a short update on the difference you helped make.
      </p>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
