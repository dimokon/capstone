<%- include('partials/header') %>
<section class="page-header"><div><span class="eyebrow">Life at Kaloboyei</span><h1>Learning looks<br>like many things.</h1></div><p>From the first question in class to the last game before home time, these are the moments that make our school.</p></section>
<section class="section"><div class="gallery-grid"><% gallery.forEach(item => { %><button class="gallery-card" type="button" data-gallery-image="<%= item.image %>" data-gallery-title="<%= item.title %>" data-gallery-category="<%= item.category %>" aria-label="Open image: <%= item.title %>"><img src="<%= item.image %>" alt="<%= item.title %>"><figcaption><small><%= item.category %></small><%= item.title %></figcaption></button><% }) %></div></section>
<div class="gallery-modal" id="galleryModal" hidden>
  <div class="gallery-modal-backdrop" data-close-gallery></div>
  <div class="gallery-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="galleryModalTitle">
    <button class="gallery-modal-close" type="button" aria-label="Close image preview">&times;</button>
    <img id="galleryModalImage" src="" alt="">
    <div class="gallery-modal-copy">
      <small id="galleryModalCategory"></small>
      <h3 id="galleryModalTitle"></h3>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
