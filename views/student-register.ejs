<%- include('partials/header') %>
<section class="login-page"><div class="login-art"><span class="eyebrow">Learner portal</span><h1>Start your<br>learning journey.</h1><p>Create your student account with the assessment details provided by Kaloboyei School.</p></div><div class="login-form-wrap"><div class="form-box"><h2>Student registration</h2><p>Use the assessment number issued by your school.</p><% if (error) { %><div class="alert"><%= error %></div><% } %><% if (success) { %><div class="success-alert"><%= success %></div><% } %><form method="post" action="/student/register"><div class="form-field"><label for="name">Full name</label><input id="name" type="text" name="name" value="<%= formData.name || '' %>" placeholder="Your full name" autocomplete="name" required></div><div class="form-field"><label for="assessmentNumber">Assessment number</label><input id="assessmentNumber" type="text" name="assessmentNumber" value="<%= formData.assessmentNumber || '' %>" placeholder="e.g. KLS2024018" required></div><div class="form-field"><label for="password">Password</label><div class="password-field"><input id="password" type="password" name="password" minlength="6" autocomplete="new-password" required><button class="password-toggle" type="button" data-password-toggle="password">Show</button></div></div><div class="form-field"><label for="confirmPassword">Confirm password</label><div class="password-field"><input id="confirmPassword" type="password" name="confirmPassword" minlength="6" autocomplete="new-password" required><button class="password-toggle" type="button" data-password-toggle="confirmPassword">Show</button></div></div><button class="button" type="submit">Create student account ↗</button></form><p class="form-switch">Already registered? <a href="/student/login">Sign in to your dashboard</a></p></div></div></section>
<%- include('partials/footer') %>