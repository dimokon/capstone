<%- include('partials/header') %>
<section class="login-page"><div class="login-art"><span class="eyebrow">Learner portal</span><h1>Your progress,<br>in your hands.</h1><p>Check your latest results, see assignments and keep track of your learning journey from anywhere.</p></div><div class="login-form-wrap"><div class="form-box"><h2>Student sign in</h2><p>Use the assessment number provided by your school.</p><% if (error) { %><div class="alert"><%= error %></div><% } %><form method="post" action="/student/login"><div class="form-field"><label for="assessmentNumber">Assessment number</label><input id="assessmentNumber" name="assessmentNumber" placeholder="e.g. KLS2024018" required autofocus></div><div class="form-field"><label for="password">Password</label><div class="password-field"><input id="password" name="password" type="password" required><button class="password-toggle" type="button" data-password-toggle="password">Show</button></div></div><button class="button" type="submit">View my dashboard ↗</button></form><div class="form-note">Demo login: <strong>KLS2024018</strong> / <strong>demo</strong></div><p class="form-switch">New student? <a href="/student/register">Create an account</a></p></div></div></section>
<%- include('partials/footer') %>
