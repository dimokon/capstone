<%- include('partials/header') %>
<section class="login-page"><div class="login-art"><span class="eyebrow">Staff workspace</span><h1>Make progress<br>visible.</h1><p>Upload results, share assignments and keep learners and families connected to the work happening in class.</p></div><div class="login-form-wrap"><div class="form-box"><h2>Teacher sign in</h2><p>Enter your school account details to continue.</p><% if (error) { %><div class="alert"><%= error %></div><% } %><form method="post" action="/teacher/login"><div class="form-field"><label for="email">School email</label><input id="email" type="email" name="email" placeholder="you@kaloboyei.org" required></div><div class="form-field"><label for="password">Password</label><div class="password-field"><input id="password" type="password" name="password" required><button class="password-toggle" type="button" data-password-toggle="password">Show</button></div></div><button class="button" type="submit">Open workspace ↗</button></form><div class="form-note">Demo login: <strong>teacher@kaloboyei.org</strong> / <strong>demo</strong></div></div></div></section>
<%- include('partials/footer') %>
