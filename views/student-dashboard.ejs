<%- include('partials/header') %>
<section class="dashboard"><div class="dashboard-top"><div><span class="eyebrow">Student portal</span><h1>Hello, <%= student.name.split(' ')[0] %>.</h1><p class="dashboard-sub"><%= student.className %> · Assessment <%= student.assessmentNumber %></p></div><form method="post" action="/student/logout"><button class="button button-outline" type="submit">Sign out</button></form></div><div class="dashboard-grid"><div><div class="panel"><h2>Term 2 overview</h2><div class="metric-row"><div class="metric"><strong><%= student.average || '—' %></strong><span>Overall average</span></div><div class="metric"><strong><%= student.position || '—' %></strong><span>Class position</span></div><div class="metric"><strong><%= student.attendance || '—' %></strong><span>Attendance</span></div></div><h2>Subject results</h2><% student.results.forEach(result => { %><div class="result-row"><div><strong><%= result.subject %></strong><% if (result.score !== null) { %><div class="score-bar"><span style="width:<%= result.score %>%"></span></div><% } %></div><strong><%= result.score === null ? 'PDF result' : result.score + '%' %></strong><span class="grade"><%= result.grade %></span><% if (result.pdfUrl && result.id) { %><a class="result-download" href="/student/results/<%= result.id %>/download">Download PDF</a><% } %></div><% }) %></div></div><div><div class="panel"><h2>Assignments</h2><% student.assignments.forEach(assignment => { %><div class="assignment"><strong><%= assignment.title %></strong><small><%= assignment.subject %> · Due <%= assignment.due %> · <%= assignment.status %></small></div><% }) %></div><div class="dashboard-note"><strong>Keep asking good questions.</strong><p>Your teachers are proud of the work you are putting in. Keep going.</p></div></div></div></section>
<%- include('partials/footer') %>
